---
import copy from "../../../content/copy.json";
import profile from "../../../content/profile.json";
---

<footer class="site-footer">
  <div class="sheet">
    <p>
      <span data-pt>{copy.footer.line.pt}</span>
      <span data-en>{copy.footer.line.en}</span>
    </p>
    <p class="magic-line">
      <span data-pt>{copy.footer.magic.pt}</span>
      <span data-en>{copy.footer.magic.en}</span>
    </p>
    <p>@{profile.handle}</p>
  </div>
</footer>
