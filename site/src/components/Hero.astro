---
import copy from "../../../content/copy.json";
import links from "../../../content/links.json";
import profile from "../../../content/profile.json";
---

<section class="hero sheet" id="topo" aria-labelledby="nome">
  <h1 id="nome">
    {profile.given}
    <br />
    {profile.family}
  </h1>
  <p class="lede">
    <span data-pt>{copy.hero.sentence.pt}</span>
    <span data-en>{copy.hero.sentence.en}</span>
  </p>
  <div class="actions">
    <a class="plaque" href={links.linkedin} target="_blank" rel="noopener noreferrer">
      <span data-pt>{copy.hero.primary.pt}</span>
      <span data-en>{copy.hero.primary.en}</span>
      <span class="sr-only">
        (<span data-pt>{copy.ui.newTab.pt}</span>
        <span data-en>{copy.ui.newTab.en}</span>)
      </span>
    </a>
    <a class="quiet" href="#projetos">
      <span data-pt>{copy.hero.secondary.pt}</span>
      <span data-en>{copy.hero.secondary.en}</span>
    </a>
  </div>
  <div class="constellation">
    <svg class="threads" aria-hidden="true"></svg>
    <div class="pins" role="group">
      <span class="sr-only" data-pt>
        Práticas na mesa
      </span>
      <span class="sr-only" data-en>
        Practices on the desk
      </span>
      {copy.hero.pins.map((pin) => (
        <button class="pin" type="button" data-pin={pin.id} aria-pressed="false">
          <span data-pt>{pin.pt}</span>
          <span data-en>{pin.en}</span>
        </button>
      ))}
    </div>
  </div>
  <p class="pin-note" data-active="hint" aria-live="polite">
    <span data-note="hint" data-pt>
      {copy.hero.pinHint.pt}
    </span>
    <span data-note="hint" data-en>
      {copy.hero.pinHint.en}
    </span>
    {copy.hero.pins.map((pin) => (
      <>
        <span data-note={pin.id} data-pt>
          {pin.note.pt}
        </span>
        <span data-note={pin.id} data-en>
          {pin.note.en}
        </span>
      </>
    ))}
  </p>
</section>
