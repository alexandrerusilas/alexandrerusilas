---
import copy from "../../../content/copy.json";
---

<section class="sheet" id="sobre" aria-labelledby="sobre-titulo">
  <h2 id="sobre-titulo">
    <span data-pt>{copy.about.title.pt}</span>
    <span data-en>{copy.about.title.en}</span>
  </h2>
  <p class="summary">
    <span data-pt>{copy.about.summary.pt}</span>
    <span data-en>{copy.about.summary.en}</span>
  </p>
  <div class="roles">
    <div class="tablist" role="tablist" aria-orientation="vertical" id="about-tabs">
      <span class="sr-only" data-pt>
        {copy.about.tabsLabel.pt}
      </span>
      <span class="sr-only" data-en>
        {copy.about.tabsLabel.en}
      </span>
      {copy.about.tabs.map((tab, index) => (
        <button
          class="tab"
          type="button"
          role="tab"
          id={`tab-${tab.id}`}
          aria-controls={`panel-${tab.id}`}
          aria-selected={index === 0 ? "true" : "false"}
          tabindex={index === 0 ? 0 : -1}
        >
          <span data-pt>{tab.pt}</span>
          <span data-en>{tab.en}</span>
        </button>
      ))}
    </div>
    {copy.about.tabs.map((tab, index) => (
      <p
        class="essay"
        role="tabpanel"
        id={`panel-${tab.id}`}
        aria-labelledby={`tab-${tab.id}`}
        hidden={index === 0 ? undefined : true}
      >
        <span data-pt>{tab.body.pt}</span>
        <span data-en>{tab.body.en}</span>
      </p>
    ))}
  </div>
</section>
